{
  "name": "mr-boxington-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "node --test .vitepress/social-images.test.mjs && vitepress build && node .vitepress/check-social-images.mjs",
    "docs:preview": "vitepress preview",
    "showreel:video": "node .vitepress/showreel-video.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.21.5",
    "playwright-core": "^1.63.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-tabs": "^0.9.1"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "glibc"
      ]
    },
    "allowBuilds": {
      "esbuild": true
    }
  }
}
